{
    "manifest_version": 3,
    "name": "JobFill",
    "description": "Fills job application forms from your saved details.",
    "version": "1.0",
    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "images/icon-48.png",
            "96": "images/icon-96.png",
            "128": "images/icon-128.png"
        }
    },
    "permissions": [
        "nativeMessaging",
        "storage"
    ],
    "host_permissions": [
        "https://job-worker.pranavrokade.workers.dev/*"
    ]
}
